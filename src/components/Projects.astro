---
import NextJS from './icons/NextJS.astro';
import NestJS from './icons/NestJS.astro';
import TailwindCSS from './icons/Tailwind.astro';
import Prisma from './icons/Prisma.astro';
import PostgreSQL from './icons/PostgreSQL.astro';
import TypeScript from './icons/Typescript.astro';
import Docker from './icons/Docker.astro';
import Java from './icons/Java.astro';
import SpringBoot from './icons/SpringBoot.astro';
import LinkButton from './LinkButton.astro';
import Github from './icons/Github.astro';
import Link from './icons/Link.astro';

const TAGS = {
	NEXT: {
		name: 'NextJS',
		color: 'bg-black text-white',
		icon: NextJS,
	},
	NEST: {
		name: 'NestJS',
		color: 'bg-slate-900 text-[#e0234e]',
		icon: NestJS,
	},
	TAILWIND: {
		name: 'TailwindCSS',
		color: 'bg-blue-900 text-white',
		icon: TailwindCSS,
	},
	PRISMA: {
		name: 'Prisma',
		color: 'bg-black text-white',
		icon: Prisma,
	},
	POSTGRESQL: {
		name: 'PostgreSQL',
		color: 'bg-blue-900 text-white',
		icon: PostgreSQL,
	},
	TYPESCRIPT: {
		name: 'TypeScript',
		color: 'bg-[#3178c6] text-white',
		icon: TypeScript,
	},
	DOCKER: {
		name: 'Docker',
		color: 'bg-blue-900 text-white',
		icon: Docker,
	},
	JAVA: {
		name: 'Java 21',
		color: 'bg-[#5382a1] text-white',
		icon: Java,
	},
	SPRINGBOOT: {
		name: 'Spring Boot',
		color: 'bg-[#6db33f] text-white',
		icon: SpringBoot,
	},
};

const PROJECTS = [
	{
		title: 'Movivendor - Facturación Integral',
		description:
			'Motor de facturación híbrido (automático y manual) conectado vía API con proveedores externos. Migración crítica de Java 11 a 21 e integración con frameworks de alto rendimiento como Vert.x.',
		link: '',
		github: '',
		image: '/img/MVV.webp', 
		tags: [
			TAGS.JAVA,
			TAGS.SPRINGBOOT,
			TAGS.POSTGRESQL,
			TAGS.DOCKER,
		],
	},
	{
		title: 'IngenieriaTI3 - Ecommerce Tech',
		description:
			'Plataforma completa utilizando NestJS y Next.js. Integración de APIs de Syscom y Conekta para gestión de productos y procesamiento de pagos con validación avanzada.',
		link: '',
		github: '',
		image: '/img/JKM.webp',
		tags: [
			TAGS.NEXT,
			TAGS.NEST,
			TAGS.TAILWIND,
			TAGS.PRISMA,
			TAGS.POSTGRESQL,
			TAGS.TYPESCRIPT,
		],
	},
	{
		title: 'Spartan - Gestión de Proyectos',
		description:
			'Sistema robusto para gestionar servicios de ingeniería sanitaria. Generación de reportes PDF dinámicos y seguimiento granular de proyectos industriales.',
		link: '',
		github: 'https://github.com/rodrigoremen/spartan-app',
		image: '/img/Spartan.webp',
		tags: [
			TAGS.NEXT,
			TAGS.TAILWIND,
			TAGS.PRISMA,
			TAGS.POSTGRESQL,
			TAGS.TYPESCRIPT,
		],
	}
];
---

<div class="flex flex-col gap-y-16">
	{
		PROJECTS.map(({ image, title, description, tags, link, github }) => (
			<article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
				<div class="w-full md:w-1/2">
					<div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
						<img
							alt="Recién llegado vs 5 años en Nueva Zelanda"
							class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
							loading="lazy"
							src={image}
						/>
					</div>
				</div>

				<div class="w-full md:w-1/2 md:max-w-lg">
					<h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
						{title}
					</h3>
					<div class="flex flex-wrap mt-2">
						<ul class="flex flex-wrap mb-2 gap-2">
							{tags.map((tag) => (
								<li>
									<span
										class={`flex gap-x-2 rounded-full text-xs ${tag.color} py-1 px-2 `}
									>
										<tag.icon class="size-4" />
										{tag.name}
									</span>
								</li>
							))}
						</ul>

						<div class="mt-2 text-gray-700 dark:text-gray-400">
							{description}
						</div>
						<footer class="flex items-end justify-start mt-4 gap-x-4">
							{github && (
								<LinkButton href={github}>
									<Github class="size-6" />
									Codigo
								</LinkButton>
							)}
							{link && (
								<LinkButton href={link}>
									<Link class="size-4" />
									Vista previa
								</LinkButton>
							)}
						</footer>
					</div>
				</div>
			</article>
		))
	}
</div>
