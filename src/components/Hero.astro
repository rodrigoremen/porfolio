---
import Badge from './Badge.astro';
import Github from './icons/Github.astro';
import LinkedIn from './icons/LinkedIn.astro';
import Mail from './icons/Mail.astro';
import WhatsApp from './icons/WhatsApp.astro';
import SocialPill from './SocialPill.astro';
---

<div class="max-w-xl">
	<div class="flex gap-4 mb-4">
		<img
			class="rounded-full shadow-lg size-16"
			src="https://avatars.githubusercontent.com/u/106606020?v=4"
			alt="rodrigoremen"
		/>
		<a
			href="https://linkedin.com/in/rodrigo-dorantes"
			target="_blank"
			rel="noopener"
			class="flex items-center transition md:justify-center md:hover:scale-105"
		>
			<Badge>Disponible para trabajar</Badge>
		</a>
	</div>
	<h1
		class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
	>
		¡Hola! Soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-green-500 to-emerald-500 animate-gradient-x">Rodrigo Dorantes</span> 👋
	</h1>
	<p
		class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-emerald-200 [&>strong]:text-emerald-600 [&>strong]:font-semibold dark:text-gray-300"
	>
		Soy un <strong>Ingeniero de Software Fullstack</strong> especializado en sistemas escalables.
		Desde México, apasionado por la <strong>arquitectura limpia, Java 21 y el desarrollo moderno con React/Next.js.</strong>
	</p>
	<p class="mt-4 text-xl text-wrap text-gray-700 dark:text-gray-400">
		Enfocado en la optimización de procesos y la creación de soluciones robustas que marcan la diferencia.
	</p>

	<nav class="flex gap-4 mt-8 flex-wrap">
		<SocialPill
			href="https://wa.me/7774429079?text=Hola%20vi%20tu%20pagina%20web,%20Hablemos!"
		>
			<WhatsApp class="size-4" />
			WhatsApp
		</SocialPill>
		<SocialPill href="https://linkedin.com/in/rodrigo-dorantes">
			<LinkedIn class="size-4" />
			LinkedIn
		</SocialPill>
		<SocialPill href="https://github.com/rodrigoremen">
			<Github class="size-4" />
			Github
		</SocialPill>
		<SocialPill href="mailto:rodrigoivan234@gmail.com">
			<Mail class="size-4" />
			rodrigoivan234@gmail.com
		</SocialPill>
	</nav>
</div>
