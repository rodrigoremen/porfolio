---
interface Props {
	date: string;
	title: string;
	content: string;
	job: string;
}
const { date, title, content, job } = Astro.props;
---

<div class="relative pb-12 last:pb-0">
	<div class="absolute left-[-33px] top-1.5 h-full w-px bg-slate-200 dark:bg-slate-800"></div>
	<div class="absolute left-[-37px] top-1.5 h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
	
	<div class="flex flex-col sm:flex-row sm:items-center justify-between mb-2">
		<h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
			{title}
		</h3>
		<time class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1 sm:mt-0">
			{date}
		</time>
	</div>
	
	<div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mb-3 uppercase tracking-wider">
		{job}
	</div>
	
	<div class="text-slate-600 dark:text-slate-300 leading-relaxed text-pretty">
		{content}
	</div>
</div>
