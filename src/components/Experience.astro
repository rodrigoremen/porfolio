---
import ExperienceItems from '../components/ExperienceItems.astro';
const EXPERIENCE = [
	{
		job: 'Desarrollador Fullstack',
		date: 'Noviembre 2024 - Presente',
		title: 'Movivendor',
		content:
			`Diseñé y desarrollé un motor de facturación híbrido conectado vía API con proveedores externos. Lideré la migración crítica de backends de Java 11 a Java 21, implementando mejoras de rendimiento sobre un framework basado en Spring Boot y Vert.x. Administro servidores Debian y desarrollé microservicios para notificaciones vía WhatsApp y reportes optimizados.`,
	},
	{
		job: 'Desarrollador Fullstack',
		date: 'Julio 2024',
		title: 'IngenieriaTI3',
		content:
			`Construí una plataforma de e-commerce completa utilizando NestJS y Next.js. Integré APIs de Syscom y Conekta para gestión de productos y pagos. Implementé un sistema de comisiones flexible, carga de archivos con Google Drive API y validación avanzada de formularios.`,
	},
	{
		job: 'Desarrollador Fullstack',
		date: 'Enero 2024 - Abril 2024',
		title: 'Spartan Ingeniería Sanitaria',
		content:
			`Desarrollé una aplicación web para la gestión integral de proyectos y servicios de la empresa. Implementé una API REST robusta y reutilizable utilizando Next.js, asegurando escalabilidad y confiabilidad en la gestión de datos con Prisma y PostgreSQL.`,
	},
	{
		job: 'Desarrollador Móvil',
		date: 'Mayo 2022 - Agosto 2022',
		title: 'Hi-Techdesign',
		content:
			`Desarrollé una aplicación móvil de e-commerce enfocada en adultos mayores. Trabajé con Spring Boot para el backend y React Native/Expo para la experiencia móvil, integrando servicios de cuidado personal y enfermería.`,
	},
];
---

<div class="w-full max-w-3xl mx-auto px-4 md:px-0">
	<div class="relative ml-8">
		{
			EXPERIENCE.map((experience) => (
				<ExperienceItems {...experience} />
			))
		}
	</div>
</div>
